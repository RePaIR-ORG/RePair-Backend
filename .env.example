# Server Port
PORT=5000

# MongoDB Connection String (Replace with your own credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.65bjflv.mongodb.net/?appName=Cluster0

# JWT Secret for authentication (Use a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Cloudinary credentials (for profile photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
API_KEY=your_api_key
API_SECRET=your_api_secret

# Gmail credentials for Nodemailer OTP email delivery
# EMAIL_USER: your Gmail address
# EMAIL_PASS: a Gmail App Password (not your account password)
#   → Google Account → Security → 2-Step Verification → App Passwords
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ── RAG (AI Task Generator) ────────────────────────────────────────────────────
# Groq API Key — used by rag/ragTaskGenerator.js
# Get a FREE key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
